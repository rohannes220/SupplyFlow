    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "@supplyflow/shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
