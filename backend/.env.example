PORT=4000
DATABASE_URL=postgres://supplyflow:change-me@localhost:5432/supplyflow
# Optional: enables the PostgreSQL-backed model tests
TEST_DATABASE_URL=postgres://supplyflow:change-me@localhost:5432/supplyflow_test
# Sign/verify login tokens. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string
# Set these to the two independently verified accounts before the first migration.
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
# Password for the demo employee account created by `pnpm seed`
SEED_EMPLOYEE_PASSWORD=change-me-employee
